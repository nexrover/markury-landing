GROQ_API_KEY=your_groq_api_key_here
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Lemon Squeezy webhook signing secret
LEMONSQUEEZY_WEBHOOK_SECRET=

# Google Play Billing (server-side verification)
PLAY_PACKAGE_NAME=com.nexrover.markury
PLAY_PRODUCT_YEARLY=markury_pro_yearly
PLAY_PRODUCT_LIFETIME=markury_pro_lifetime
PLAY_PRODUCT_YEARLY_DISCOUNTED=markury_pro_yearly_discount
PLAY_PRODUCT_LIFETIME_DISCOUNTED=markury_pro_lifetime_discount
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
# Set true only for local/dev to accept purchaseToken values starting with mock_
# mock_*trial* → 7-day trial expiry; other mock_* → yearly expiry
PLAY_BILLING_MOCK=false
# Optional shared secret for Pub/Sub push to /api/webhooks/google-play
GOOGLE_PLAY_RTDN_SECRET=sdfsf


# Admin API for creating dynamic Play discount codes
ADMIN_API_SECRET=

# Resend — Google Play purchase receipt emails (order + license key)
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@markury.app
RESEND_FROM_NAME=Markury
